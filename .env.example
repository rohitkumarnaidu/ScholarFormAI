# AMF Configuration
# Copy this file to .env and customize

# Application
AMF_ENVIRONMENT=development
AMF_DEBUG=true
AMF_SECRET_KEY=generate-a-unique-secret-key-here
AMF_LOG_LEVEL=info
AMF_ALLOWED_ORIGINS=http://localhost:3000

# Server
AMF_API_HOST=127.0.0.1
AMF_API_PORT=8000

# Uploads
AMF_MAX_UPLOAD_SIZE=10485760
AMF_UPLOAD_DIR=./uploads

# Rate Limiting
AMF_RATE_LIMIT_DEFAULT=60
AMF_RATE_LIMIT_WINDOW=60

# Optional: External Services
AMF_SENTRY_DSN=
AMF_DATABASE_URL=
AMF_REDIS_URL=

# CORS
AMF_CSP_DIRECTIVES=
AMF_HSTS_MAX_AGE=31536000

# Logging
AMF_LOG_FORMAT=console
AMF_LOG_FILE=
AMF_ENABLE_AUDIT_LOG=true
