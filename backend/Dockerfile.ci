# syntax=docker/dockerfile:1.4
# SPDX-License-Identifier: MIT
# CI-only lightweight Dockerfile for backend build verification.
# Uses requirements-test.txt instead of full requirements.txt to avoid OOM/timeout.
# NOT for production use — use backend/docker/Dockerfile for production.

FROM python:3.12-slim AS builder

WORKDIR /build

# Install only lightweight test dependencies (excludes torch, paddleocr, onnxruntime etc.)
COPY requirements-test.txt .
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --prefix=/install -r requirements-test.txt

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AMF_ENVIRONMENT=production \
    AMF_DEBUG=false

WORKDIR /app

COPY --from=builder /install /usr/local
COPY alembic.ini .
COPY alembic/ alembic/
COPY app/ app/

RUN groupadd -r appuser && useradd -r -g appuser appuser
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health/live')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
